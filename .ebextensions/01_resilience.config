# Resilience hardening for the single-instance Elastic Beanstalk environment.
# Goal (see docs/RELIABILITY.md): a bad deploy can never take the live site
# down, a wedged instance heals itself, and the team is alerted the instant
# health degrades — so the 2026-10-02 "No Data" outage can't repeat.
option_settings:
  # IMMUTABLE DEPLOYS — the big one. Each deploy launches a brand-new instance
  # that must pass the health check BEFORE any traffic swap. If it fails, EB
  # throws it away and the current instance keeps serving: automatic rollback,
  # zero downtime, and a fresh disk every deploy (old images can't accumulate).
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Immutable
    Timeout: "1800"

  # Enhanced health: real per-instance health + "No Data" detection, and the
  # signal the email alert below fires on.
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

  # Judge health by the app itself (EB polls this URL), not just an open port —
  # a lightweight liveness probe that does not touch the database.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/health

  # Email the ops inbox the moment environment health degrades (or recovers).
  # AWS sends a one-time "Confirm subscription" email to this address — click it
  # once or alerts won't arrive. Change the address here to re-point alerts.
  aws:elasticbeanstalk:sns:topics:
    Notification Endpoint: sean@ghsbarrie.ca

  # Keep platform security patches flowing, applied in a quiet Sunday window.
  aws:elasticbeanstalk:managedactions:
    ManagedActionsEnabled: true
    PreferredStartTime: "Sun:07:00"
  aws:elasticbeanstalk:managedactions:platformupdate:
    UpdateLevel: minor
