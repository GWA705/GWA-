# ---------------------------------------------------------------------------
# GWA Credit Portal — environment configuration
# Copy to `.env` for local development. NEVER commit real secrets.
# In production (AWS ca-central-1) these come from AWS Secrets Manager / SSM.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Locally you can run:
#   docker run -d --name gwa-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gwa?schema=public"

# Base URL of the app (used for absolute links in emails, etc.)
APP_URL="http://localhost:3000"

# ---- Session signing -------------------------------------------------------
# 32+ byte random secret used to sign session cookies (HS256).
# Generate: openssl rand -base64 48
SESSION_SECRET="dev-only-change-me-generate-with-openssl-rand-base64-48-aaaaaaaa"

# ---- Application-level field encryption -----------------------------------
# Master key for envelope encryption of sensitive fields (SIN, bank, ID) and
# documents at rest. 32 raw bytes, base64-encoded.
# Generate: openssl rand -base64 32
# PRODUCTION: leave blank and set KMS_KEY_ID instead so the master key is
# managed by AWS KMS and never leaves the HSM boundary.
MASTER_ENCRYPTION_KEY="bYsJGjzTh2h3ZV3ftbh1GH0o8hDZOP5IVsyAgyhS75g="

# Production only: AWS KMS CMK used to wrap per-record data keys.
# When set, MASTER_ENCRYPTION_KEY is ignored and KMS is used instead.
KMS_KEY_ID=""
AWS_REGION="ca-central-1"

# ---- Document storage ------------------------------------------------------
# "local" = encrypted files on local disk (dev). "s3" = AWS S3 (production).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# S3 (production, ca-central-1 for Canadian data residency)
S3_BUCKET=""
S3_REGION="ca-central-1"
# In production use SSE-KMS on the bucket; leave AWS creds to the IAM role.

# ---- First admin bootstrap (used only by the seed script) ------------------
SEED_ADMIN_EMAIL="admin@gwa.example"
SEED_ADMIN_PASSWORD="ChangeMe!Admin123"
