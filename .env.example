# ---------------------------------------------------------------------------
# GWA Credit Portal — environment configuration
# Copy to `.env` for local development. NEVER commit real secrets.
# In production (AWS ca-central-1) these come from AWS Secrets Manager / SSM.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Locally you can run:
#   docker run -d --name gwa-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gwa?schema=public"

# Base URL of the app (used for absolute links in emails, etc.)
APP_URL="http://localhost:3000"

# ---- Session signing -------------------------------------------------------
# 32+ byte random secret used to sign session cookies (HS256).
# Generate: openssl rand -base64 48
SESSION_SECRET="dev-only-change-me-generate-with-openssl-rand-base64-48-aaaaaaaa"

# ---- Application-level field encryption -----------------------------------
# Master key for envelope encryption of sensitive fields (SIN, bank, ID) and
# documents at rest. 32 raw bytes, base64-encoded.
# Generate: openssl rand -base64 32
# PRODUCTION: leave blank and set KMS_KEY_ID instead so the master key is
# managed by AWS KMS and never leaves the HSM boundary.
MASTER_ENCRYPTION_KEY="bYsJGjzTh2h3ZV3ftbh1GH0o8hDZOP5IVsyAgyhS75g="

# Production only: AWS KMS CMK used to wrap per-record data keys.
# When set, MASTER_ENCRYPTION_KEY is ignored and KMS is used instead.
KMS_KEY_ID=""
AWS_REGION="ca-central-1"

# ---- Document storage ------------------------------------------------------
# "local" = encrypted files on local disk (dev only — wiped on redeploy, and
# does NOT work on serverless hosts like Vercel). "s3" = S3 / S3-compatible
# object storage (use this in production so uploads persist).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# S3 settings (used when STORAGE_DRIVER=s3). Recommended: AWS S3 in
# ca-central-1 (Montreal) for Canadian data residency.
S3_BUCKET=""
S3_REGION="ca-central-1"
# Bucket-side encryption: "AES256" (default, no setup), "aws:kms" (+ S3_KMS_KEY_ID),
# or "none". File bytes are already app-encrypted regardless.
S3_SSE="AES256"
S3_KMS_KEY_ID=""
# Credentials: on AWS with an IAM role, leave these blank. On Vercel/other hosts
# with no role, set an IAM user's keys (least-privilege: Get/Put/Delete on the
# bucket only). The standard AWS_* names are picked up automatically.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional — for S3-compatible services (e.g. Cloudflare R2) or local testing.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="true"

# ---- Email (transactional) -------------------------------------------------
# Provider-agnostic SMTP. Leave BLANK to run in safe "log-only" mode (emails are
# logged, not sent). Fill these in to switch sending on.
#
# Google Workspace example (dedicated mailbox + App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=hello@ghsbarrie.ca         # a REAL mailbox (not a Google Group)
#   SMTP_PASS=<16-char app password>     # Google Account > Security > App passwords
#   EMAIL_FROM=team@ghsbarrie.ca         # the group address emails come FROM
#   EMAIL_FROM_NAME=GWA Dealer Portal
#   EMAIL_REPLY_TO=team@ghsbarrie.ca     # where replies go (defaults to EMAIL_FROM)
# The From name / From address / Reply-To can also be set in the portal (admin →
# Email), which overrides these and needs no redeploy. See docs/EMAIL-SMTP.md.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
EMAIL_FROM_NAME="GWA Dealer Portal"
EMAIL_REPLY_TO=""

# ---- Address autocomplete (Google Places) ----------------------------------
# Optional. Leave BLANK and the "Street address" field is a normal text box.
# Set a Google Maps JavaScript API key (with the Places API enabled) to turn on
# type-ahead address suggestions that fill in city, province, and postal code.
#   1. console.cloud.google.com -> create/select a project (billing required).
#   2. Enable "Maps JavaScript API" and "Places API".
#   3. Create an API key; restrict it to HTTP referrers (your portal domain).
#   4. Put the key here / in Render env, then redeploy (this is a build-time
#      public value, so a rebuild is needed for it to take effect).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---- First admin bootstrap (used only by the seed script) ------------------
SEED_ADMIN_EMAIL="admin@gwa.example"
SEED_ADMIN_PASSWORD="ChangeMe!Admin123"
