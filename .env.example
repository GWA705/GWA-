# ---------------------------------------------------------------------------
# GWA Credit Portal — environment configuration
# Copy to `.env` for local development. NEVER commit real secrets.
# In production (AWS ca-central-1) these come from AWS Secrets Manager / SSM.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Locally you can run:
#   docker run -d --name gwa-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gwa?schema=public"

# Base URL of the app (used for absolute links in emails, etc.)
APP_URL="http://localhost:3000"

# ---- Session signing -------------------------------------------------------
# 32+ byte random secret used to sign session cookies (HS256).
# Generate: openssl rand -base64 48
SESSION_SECRET="dev-only-change-me-generate-with-openssl-rand-base64-48-aaaaaaaa"

# ---- Application-level field encryption -----------------------------------
# Master key for envelope encryption of sensitive fields (SIN, bank, ID) and
# documents at rest. 32 raw bytes, base64-encoded.
# Generate your OWN key (never reuse this example): openssl rand -base64 32
# Set this in production and manage it as a secret (Render env / secret store).
# SECURITY: this is a placeholder — do NOT ship a real key in this file.
MASTER_ENCRYPTION_KEY=""

# AWS KMS-managed master key. NOT YET SUPPORTED — leave BLANK. Setting this
# today makes encryption throw (KMS wrapping requires the async-crypto work
# tracked in docs/SECURITY-AUDIT.md). Use MASTER_ENCRYPTION_KEY for now.
KMS_KEY_ID=""
AWS_REGION="ca-central-1"

# ---- Document storage ------------------------------------------------------
# "local" = encrypted files on local disk (dev only — wiped on redeploy, and
# does NOT work on serverless hosts like Vercel). "s3" = S3 / S3-compatible
# object storage (use this in production so uploads persist).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# S3 settings (used when STORAGE_DRIVER=s3). Recommended: AWS S3 in
# ca-central-1 (Montreal) for Canadian data residency.
S3_BUCKET=""
S3_REGION="ca-central-1"
# Bucket-side encryption: "AES256" (default, no setup), "aws:kms" (+ S3_KMS_KEY_ID),
# or "none". File bytes are already app-encrypted regardless.
S3_SSE="AES256"
S3_KMS_KEY_ID=""
# Credentials: on AWS with an IAM role, leave these blank. On Vercel/other hosts
# with no role, set an IAM user's keys (least-privilege: Get/Put/Delete on the
# bucket only). The standard AWS_* names are picked up automatically.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional — for S3-compatible services (e.g. Cloudflare R2) or local testing.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="true"

# ---- Email (transactional) -------------------------------------------------
# Provider-agnostic SMTP. Leave BLANK to run in safe "log-only" mode (emails are
# logged, not sent). Fill these in to switch sending on.
#
# Google Workspace example (dedicated mailbox + App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=hello@ghsbarrie.ca         # a REAL mailbox (not a Google Group)
#   SMTP_PASS=<16-char app password>     # Google Account > Security > App passwords
#   EMAIL_FROM=team@ghsbarrie.ca         # the group address emails come FROM
#   EMAIL_FROM_NAME=GWA Dealer Portal
#   EMAIL_REPLY_TO=team@ghsbarrie.ca     # where replies go (defaults to EMAIL_FROM)
# The From name / From address / Reply-To can also be set in the portal (admin →
# Email), which overrides these and needs no redeploy. See docs/EMAIL-SMTP.md.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
EMAIL_FROM_NAME="GWA Dealer Portal"
EMAIL_REPLY_TO=""

# ---- Address autocomplete (Google Places) ----------------------------------
# Optional. Leave BLANK and the "Street address" field is a normal text box.
# Set a Google Maps JavaScript API key (with the Places API enabled) to turn on
# type-ahead address suggestions that fill in city, province, and postal code.
#   1. console.cloud.google.com -> create/select a project (billing required).
#   2. Enable "Maps JavaScript API" and "Places API".
#   3. Create an API key; restrict it to HTTP referrers (your portal domain).
#   4. Put the key here / in Render env, then redeploy (this is a build-time
#      public value, so a rebuild is needed for it to take effect).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---- First admin bootstrap (used only by the seed script) ------------------
# Set a strong password here (or in Render env). If left blank, the seed script
# generates a random one and prints it once to the deploy log — never a known
# default. The admin must change it at first login regardless.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ---- Google Sheets sales journal ("Write to Journal") ----------------------
# When set (together with a Google service-account credential), reviewers can
# push an approved deal into the GHS sales-journal spreadsheet.
#   JOURNAL_SHEET_ID          the spreadsheet ID from its URL (…/d/<ID>/edit)
#   GOOGLE_APPLICATION_CREDENTIALS  path to the service-account JSON key. On
#     Render this is a Secret File, e.g. /etc/secrets/gwa-journal-writer.json.
#   GOOGLE_SERVICE_ACCOUNT_JSON     alternative to the file path: the raw JSON
#     key as a single env var (used if the file path is not set).
# Share the target sheet with the service account's email as an Editor.
JOURNAL_SHEET_ID=""
# GOOGLE_APPLICATION_CREDENTIALS="/etc/secrets/gwa-journal-writer.json"
#
# ---- Reporting: read the year journals ----
# The reporting area reads the GHS Sales Journal spreadsheets to compute the
# reports. Set one spreadsheet ID per year using the pattern
# JOURNAL_SHEET_ID_<YEAR> — the reader resolves the right sheet for whatever
# year a report covers (current year + previous year for the comparisons). The
# 2026 id falls back to JOURNAL_SHEET_ID above. Add a new line each year as the
# next journal is created. The service account needs at least VIEW access to
# each sheet.
# NOTE: the older 2024 book uses a different layout (a metadata block, a two-row
# header, and no "Location" column). The reader detects and handles this
# automatically — just set its id below and share it with the service account.
JOURNAL_SHEET_ID_2024=""
JOURNAL_SHEET_ID_2025=""
JOURNAL_SHEET_ID_2026=""
JOURNAL_SHEET_ID_2027=""
#
# ---- HD leads log ----
# The Google Sheet the HD leads are written to (shared with the same service
# account, Viewer). Powers the per-office leads page and its health check.
HD_LEADS_SHEET_ID=""

# ---- Desktop push notifications (Web Push) ---------------------------------
# Reviewers can enable browser desktop notifications (My account → Desktop
# notifications). Generate a VAPID keypair once with:
#   npx web-push generate-vapid-keys
# Then set all three (the public key value goes in BOTH the server and the
# NEXT_PUBLIC_ var so the browser can subscribe):
#   VAPID_PUBLIC_KEY / NEXT_PUBLIC_VAPID_PUBLIC_KEY  the public key (same value)
#   VAPID_PRIVATE_KEY                                 the private key (secret)
#   VAPID_SUBJECT                                     a mailto: contact URL
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:portal@ghsbarrie.ca"

# ---- Scheduled jobs (cron) -------------------------------------------------
# Shared secret protecting the scheduled endpoints. Set the SAME value on the
# Render Cron Jobs that call them (send it as: Authorization: Bearer <secret>):
#   /api/cron/attention-alerts   reviewer "new deal waiting >2h" alert (~every 15m)
#   /api/cron/dealer-reminders   escalating dealer idle-deal reminders (~every 15m)
# The endpoints return 503 until this is set. See docs/REMINDERS.md.
CRON_SECRET=""

# ---- FinanceIt API integration (dormant until set) -------------------------
# Inbound webhooks and outbound calls stay OFF until these are configured, so
# it's safe to deploy without them. Confirm the exact values + signature scheme
# with FinanceIt (see docs/FINANCEIT-API.md).
FINANCEIT_WEBHOOK_SECRET=""            # HMAC secret FinanceIt signs webhooks with
FINANCEIT_API_KEY=""                   # bearer/API key for outbound calls
FINANCEIT_API_BASE="https://api.financeit.io"  # confirm the real base URL
# FINANCEIT_WEBHOOK_SKEW_SECONDS="300" # optional replay window (default 300s)
