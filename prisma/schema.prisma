// GWA Credit Portal — data model
// Sensitive PII fields (SIN, bank account, ID number) are stored as
// application-encrypted ciphertext (see src/lib/crypto.ts). Column-level
// encryption is layered on top of database-at-rest encryption (RDS + KMS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Roles & tenancy
// ---------------------------------------------------------------------------

enum Role {
  DEALER_USER // external dealer staff — scoped to their dealer
  REVIEWER    // internal GWA underwriter / funder
  ADMIN       // internal GWA administrator
}

// An admin-managed announcement / banner shown to dealers above their
// applications. Can be news text and/or an uploaded banner image.
model Announcement {
  id              String   @id @default(cuid())
  title           String?
  body            String?  @db.Text
  linkUrl         String?
  imageStorageKey String? // uploaded banner image (encrypted at rest)
  imageMime       String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A single-use, expiring token backing the "forgot password" self-service
// reset. Only the SHA-256 hash of the token is stored; the raw token lives
// only in the emailed link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Dealer-facing content shown under the top-nav tabs (Resources, HD
// Promotions, HD Credit Card guide). Admin-managed. Each item can be a note,
// a link, and/or an uploaded file (encrypted at rest).
enum ContentSection {
  RESOURCE
  HD_PROMOTION
  HD_CREDIT_CARD
}

model ContentItem {
  id             String         @id @default(cuid())
  section        ContentSection
  title          String
  body           String?        @db.Text
  linkUrl        String?
  fileStorageKey String? // uploaded attachment (encrypted at rest)
  fileMime       String?
  fileName       String?
  active         Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([section, active])
}

// A finance company a deal can be approved through (admin-managed list).
// Small key/value store for admin-editable app settings (e.g. the email
// From/Reply-To group addresses). SMTP credentials stay in env, not here.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model FinanceCompany {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  applications Application[]
}

// A dealership (external partner). Tenancy boundary: dealer users only ever
// see applications belonging to their own dealer.
model Dealer {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  applications     Application[]
  homeDepotStores  HomeDepotStore[]
}

// Home Depot stores available to a given dealer. The store field on an
// application is chosen from the dealer's assigned stores (a dropdown, not
// free text). Admins manage which stores belong to each dealer.
model HomeDepotStore {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  number    String // Home Depot store number
  name      String? // optional store name/location label
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  applications Application[]

  @@index([dealerId])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean @default(true)

  // Multi-factor auth. Method is 'APP' (authenticator TOTP) or 'EMAIL' (a code
  // emailed at login). Secret is application-encrypted (APP only).
  mfaEnabled       Boolean @default(false)
  mfaMethod        String? // 'APP' | 'EMAIL'
  mfaSecretEnc     String? // encrypted TOTP secret (APP method)
  // Emailed one-time code (EMAIL method) — stored hashed, short-lived.
  mfaEmailCodeHash      String?
  mfaEmailCodeExpiresAt DateTime?

  // Dealer users belong to a dealer; internal staff have dealerId = null.
  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  // Profile & notification preferences
  phone             String?
  notificationEmail String? // where notifications go; falls back to `email`
  notifyStatusUpdates Boolean @default(true)
  notifyNewNotes      Boolean @default(true)
  notifyNewDocuments  Boolean @default(true) // for reviewers/admins

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  // Password lifecycle. passwordChangedAt drives the 90-day expiry policy;
  // null is treated as "never set" and forces a change at next login.
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens  PasswordResetToken[]
  applicationsCreated  Application[]   @relation("ApplicationCreatedBy")
  applicationsApproved Application[]   @relation("ApplicationApprover")
  documentsUploaded    Document[]      @relation("DocumentUploader")
  documentsVerified    Document[]      @relation("DocumentVerifier")
  decisions           Decision[]
  statusEvents        StatusEvent[]
  auditLogs           AuditLog[]
  payoutsRecorded     Payout[]
  notesAuthored       Note[]
  confirmations       Confirmation[]

  @@index([dealerId])
}

// ---------------------------------------------------------------------------
// Applications
// ---------------------------------------------------------------------------

enum Province {
  AB
  BC
  MB
  NB
  NL
  NS
  NT
  NU
  ON
  PE
  QC
  SK
  YT
}

// How the dealer provided the credit application.
enum EntryMethod {
  TYPED // entered directly into the site (full loan application)
  PHOTO // uploaded a photo of the paper credit application
  FINANCEIT // provided a FinanceIt approval number (already approved)
}

enum HousingStatus {
  OWN
  RENT
  OTHER
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  RETIRED
  OTHER
}

// Financing program and its product sub-category.
enum ProgramType {
  HD
  GWA
}

enum ProgramCategory {
  WATER
  AIR
  SMELL_BUSTERS
  HVAC
}

enum ConfirmationStatus {
  PENDING // not confirmed yet
  COMPLETED // confirmation call completed, all questions confirmed
  ISSUE // a problem was found during confirmation
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CONDITIONAL // approved pending additional documents
  APPROVED
  DECLINED
  FUNDING_SUBMITTED // dealer has uploaded the funding package
  FUNDING_REVIEW
  FUNDED
  PROBLEM // something needs attention / is blocked
  WITHDRAWN
}

model Application {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(SUBMITTED)

  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])

  createdById String
  createdBy   User   @relation("ApplicationCreatedBy", fields: [createdById], references: [id])

  // ---- Non-sensitive descriptive fields (plaintext, needed for search/queue)
  province        Province
  programType     ProgramType
  programCategory ProgramCategory
  requestedAmount Decimal @db.Decimal(12, 2)

  // Approval details (set by the reviewer when approving)
  approvedAmount   Decimal?        @db.Decimal(12, 2)
  financeCompanyId String?
  financeCompany   FinanceCompany? @relation(fields: [financeCompanyId], references: [id])
  approvedById     String?
  approvedBy       User?           @relation("ApplicationApprover", fields: [approvedById], references: [id])

  // How this application was provided by the dealer.
  entryMethod EntryMethod @default(TYPED)

  // Confirmation-call status (surfaced to the dealer with a colour badge).
  confirmationStatus ConfirmationStatus @default(PENDING)

  // Deal details (dealer-entered)
  dateOfSale       DateTime?
  installationDate DateTime?
  homeDepotStoreId String?
  homeDepotStore   HomeDepotStore? @relation(fields: [homeDepotStoreId], references: [id])
  financingNote    String?         @db.Text

  // Reference numbers (used by search; optional until known)
  loanReference    String?
  financeReference String?
  hdReference      String?
  financeItNumber  String? // FinanceIt approval number (approved when present)

  // Applicant identity — names/contact kept plaintext for staff triage.
  applicantFirstName String
  applicantLastName  String
  applicantEmail     String
  applicantPhone     String

  // ---- Sensitive PII (application-encrypted ciphertext) ----
  applicantSinEnc         String? // Social Insurance Number
  applicantDobEnc         String? // date of birth
  applicantAddressEnc     String? // full street address
  bankAccountEnc          String? // from void cheque / PAP (transit/institution/account)
  govIdNumberEnc          String? // driver's licence / passport number

  // Co-applicant (optional) — sensitive fields also encrypted.
  coApplicantName    String?
  coApplicantSinEnc  String?

  incomeAnnual Decimal? @db.Decimal(12, 2)
  employer     String?
  notes        String?  @db.Text

  homeownershipRequired Boolean @default(false)

  // Reviewer queue signals. lastDealerActionAt is set whenever the dealer does
  // something the reviewer may need to act on (submit, upload, note, funding);
  // lastReviewerActionAt is set whenever a reviewer/admin acts. When the dealer
  // acted more recently than the reviewer, the deal "needs attention". The kind
  // labels the most recent dealer action for the activity chip.
  lastDealerActionAt   DateTime?
  lastDealerActionKind String? // 'SUBMITTED' | 'DOCUMENT' | 'NOTE' | 'FUNDING'
  lastReviewerActionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents       Document[]
  serialNumbers   SerialNumber[]
  decisions       Decision[]
  statusEvents    StatusEvent[]
  consents        Consent[]
  loanApplication LoanApplication?
  payouts         Payout[]
  dealNotes       Note[]
  confirmation    Confirmation?

  @@index([dealerId])
  @@index([status])
  @@index([createdAt])
  @@index([homeDepotStoreId])
  @@index([loanReference])
  @@index([financeReference])
  @@index([hdReference])
  @@index([financeItNumber])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentType {
  // Application stage
  SUPPORTING // generic supporting document at application time
  // Funding stage
  SIGNED_CONTRACT
  VOID_CHEQUE_OR_PAP
  INSTALL_PHOTO
  SIGNED_HD_DOCUMENT
  HD_WAIVER
  PROOF_OF_HOMEOWNERSHIP
  GOVERNMENT_ID
  // Reviewer -> dealer paperwork
  HD_PAPERWORK
  FINANCING_PAPERWORK
  RELEASE_OF_FUNDS
  OTHER
}

enum DocumentStage {
  APPLICATION
  FUNDING
  REVIEWER // paperwork uploaded by GWA staff for the dealer
}

model Document {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type  DocumentType
  stage DocumentStage

  fileName     String // standardized display name (customer + date + timestamp)
  originalName String? // the file name as uploaded
  mimeType     String
  sizeBytes    Int
  // Storage key (S3 key or local relative path). File bytes are encrypted at
  // rest (SSE-KMS on S3, or envelope-encrypted on the local driver).
  storageKey String
  checksum   String // sha-256 of plaintext, for integrity

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  // Reviewer verification — a reviewer views the document and marks it complete.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([type])
}

// Extended loan-application details captured when the dealer types the
// application in (entryMethod = TYPED), mirroring the paper loan application.
// The most sensitive identifiers (SIN, DOB, street address, banking, gov ID
// number) live encrypted on Application; these lower-sensitivity structured
// fields are stored here (still protected by database-at-rest encryption).
model LoanApplication {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Personal details
  middleName    String?
  homePhone     String?
  maritalStatus String?

  // Housing
  housingStatus     HousingStatus?
  monthlyHousingCost Decimal?       @db.Decimal(10, 2)
  yearsAtAddress    Int?
  city              String?
  addressProvince   String?
  postalCode        String?

  // Optional additional addresses
  mailingAddress   String?
  mailingCity      String?
  mailingProvince  String?
  mailingPostal    String?
  previousAddress  String?
  previousCity     String?
  previousProvince String?
  previousPostal   String?
  worksiteAddress  String?
  worksiteCity     String?
  worksiteProvince String?
  worksitePostal   String?

  // Borrower identification
  idType     String?
  idProvince String?
  idExpiry   DateTime?

  // Employment & income
  businessName      String?
  positionTitle     String?
  employerAddress   String?
  employerPhone     String?
  grossMonthlyIncome Decimal?         @db.Decimal(12, 2)
  timeAtJobYears    Int?
  employmentStatus  EmploymentStatus?

  // ---- Co-applicant (optional) ----
  // Revealed on the form when a co-applicant name is entered; collects the same
  // details as the main applicant. Sensitive fields (date of birth, street
  // address, government ID number) are application-encrypted at rest.
  coFirstName     String?
  coLastName      String?
  coMiddleName    String?
  coDobEnc        String?
  coEmail         String?
  coPhone         String?
  coHomePhone     String?
  coMaritalStatus String?
  coRelationship  String?

  coAddressEnc    String?
  coCity          String?
  coProvince      String?
  coPostal        String?

  coIdType         String?
  coGovIdNumberEnc String?
  coIdProvince     String?
  coIdExpiry       DateTime?

  coBusinessName       String?
  coPositionTitle      String?
  coEmployerAddress    String?
  coEmployerPhone      String?
  coGrossMonthlyIncome Decimal?          @db.Decimal(12, 2)
  coTimeAtJobYears     Int?
  coEmploymentStatus   EmploymentStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A payment made to the dealer on a deal — the dealer's payout receipt.
// A deal can have more than one (e.g. partial payments); together they read
// as a statement of what was paid.
model Payout {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(12, 2)
  paidOn        DateTime
  method        String? // e.g. EFT, cheque
  reference     String? // payment reference number
  note          String?
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// A note on a deal. internal=false is visible to the dealer (a conversation
// between GWA and the dealer); internal=true is reviewer/admin only.
model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  body          String      @db.Text
  internal      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// A confirmation call worked through the UEI confirmation script. One per deal.
model Confirmation {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Header
  productName   String?
  numberOfCalls Int?
  city          String?
  district      String?
  phoneNumber   String?

  // Questions 1–3
  installedWorking        Boolean @default(false)
  performingAsRepresented Boolean @default(false)
  receivedEverything      Boolean @default(false)

  // Terms
  financingAmount        Decimal?  @db.Decimal(12, 2)
  termMonths             Int?
  firstInstallmentAmount Decimal?  @db.Decimal(12, 2)
  firstInstallmentDate   DateTime?

  // Verification 4–6
  termsAgreed        Boolean @default(false)
  signatureConfirmed Boolean @default(false)
  notTrialOffer      Boolean @default(false)

  specialArrangements String?
  hdNotes             String? @db.Text // HD confirmation notes
  issueNote           String? @db.Text

  confirmedById String?
  confirmedBy   User?     @relation(fields: [confirmedById], references: [id])
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SerialNumber {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  value         String
  productLabel  String? // e.g. "Furnace", "Water Heater"
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Decisions, status history, consent, audit
// ---------------------------------------------------------------------------

enum DecisionType {
  APPROVE
  DECLINE
  CONDITIONAL
  REQUEST_DOCS
  FUND
}

model Decision {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DecisionType
  notes         String?      @db.Text
  decidedById   String
  decidedBy     User         @relation(fields: [decidedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([applicationId])
}

model StatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from          ApplicationStatus?
  to            ApplicationStatus
  actorId       String
  actor         User              @relation(fields: [actorId], references: [id])
  note          String?
  createdAt     DateTime          @default(now())

  @@index([applicationId])
}

// Records consent captured from the dealer/applicant at submission time.
model Consent {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  policyVersion  String
  consentText    String      @db.Text
  ipAddress      String?
  capturedAt     DateTime    @default(now())

  @@index([applicationId])
}

// Append-only audit trail of sensitive access and mutations (PIPEDA / Law 25).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String   // e.g. "PII_DECRYPT", "APPLICATION_SUBMIT", "DOC_DOWNLOAD"
  entityType String   // e.g. "Application", "Document", "User"
  entityId   String?
  detail     String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
