// GWA Credit Portal — data model
// Sensitive PII fields (SIN, bank account, ID number) are stored as
// application-encrypted ciphertext (see src/lib/crypto.ts). Column-level
// encryption is layered on top of database-at-rest encryption (RDS + KMS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Roles & tenancy
// ---------------------------------------------------------------------------

enum Role {
  DEALER_USER // external dealer staff — scoped to their dealer
  REVIEWER    // internal GWA underwriter / funder
  ADMIN       // internal GWA administrator
}

// An admin-managed announcement / banner shown to dealers above their
// applications. Can be news text and/or an uploaded banner image.
model Announcement {
  id              String   @id @default(cuid())
  title           String?
  body            String?  @db.Text
  linkUrl         String?
  imageStorageKey String? // uploaded banner image (encrypted at rest)
  imageMime       String?
  active          Boolean  @default(true)
  // Where the sign shows on the dealer dashboard: "TOP" (above the deals, the
  // default) or "BOTTOM" (after the deals list).
  position        String   @default("TOP")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A browser push-notification subscription (Web Push). One row per browser a
// user enables desktop notifications in. The endpoint + keys come from the
// browser's PushManager; we send to them with the VAPID keypair. Stale ones
// (410/404 on send) are pruned automatically.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// An admin-managed "must-read" pop-up shown to dealers. Unlike the dashboard
// sign (Announcement), a dealer has to actively dismiss it, and that dismissal
// is recorded (AlertAck) so admins can see who has read it and it won't nag them
// again. dealerId null = shown to every dealer; set = only that dealer.
model DealerAlert {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text
  linkUrl     String?
  active      Boolean  @default(true)
  // Who sees this pop-up: ALL_DEALERS | DEALER (a specific dealer) | REVIEWERS |
  // ADMINS | STAFF (reviewers + admins) | EVERYONE.
  audience    String   @default("ALL_DEALERS")
  dealerId    String? // set only when audience = DEALER
  dealer      Dealer?  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acks AlertAck[]

  @@index([active])
}

// One dealer user's acknowledgement of a DealerAlert (they pressed X / "I've
// read this"). The unique pair means it shows once per person until dismissed.
model AlertAck {
  id             String      @id @default(cuid())
  alertId        String
  alert          DealerAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime    @default(now())

  @@unique([alertId, userId])
  @@index([alertId])
}

// An inbound webhook delivery from a third party (e.g. FinanceIt). Stored for
// idempotency (the unique [source, eventId] means a retried delivery is only
// processed once) and as an audit/reconciliation trail of every callback.
model WebhookEvent {
  id            String    @id @default(cuid())
  source        String // e.g. "financeit"
  eventId       String // the provider's unique delivery/event id
  eventType     String?
  status        String    @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | ERROR
  applicationId String?
  error         String?   @db.Text
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  @@unique([source, eventId])
  @@index([source, eventType])
}

// One escalating "your deal is still waiting on you" reminder sent to a dealer
// for an idle deal (approved awaiting paperwork, conditional, or a flagged
// problem). Logged so the cadence engine can enforce the per-day cap, the
// every-other-day step-down, and the twice-a-week tail without re-sending. The
// schedule itself is admin-configurable (see src/lib/reminders.ts).
model DealerReminder {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dayNumber     Int // whole days the deal had been waiting when this fired
  phase         String // 'ramp' | 'weekly'
  priority      Boolean     @default(false)
  reason        String?     @db.Text // the "what you're waiting for" blurb that was sent
  emailedCount  Int         @default(0) // dealer users emailed
  pushedCount   Int         @default(0) // dealer users push-notified
  sentAt        DateTime    @default(now())

  @@index([applicationId, sentAt])
  @@index([sentAt])
}

// A durable fixed-window rate-limit counter, keyed by a caller-defined string
// (e.g. "login:ip:1.2.3.4"). Backed by the DB so limits hold across the multiple
// app instances Render runs. Rows are transient; a periodic cleanup can prune
// expired ones.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// A single-use, expiring token backing the "forgot password" self-service
// reset. Only the SHA-256 hash of the token is stored; the raw token lives
// only in the emailed link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Dealer-facing content shown under the top-nav tabs (Resources, HD
// Promotions, HD Credit Card guide). Admin-managed. Each item can be a note,
// a link, and/or an uploaded file (encrypted at rest).
enum ContentSection {
  RESOURCE
  HD_PROMOTION
  HD_CREDIT_CARD
}

model ContentItem {
  id             String         @id @default(cuid())
  section        ContentSection
  title          String
  body           String?        @db.Text
  linkUrl        String?
  fileStorageKey String? // uploaded attachment (encrypted at rest)
  fileMime       String?
  fileName       String?
  // Optional custom cover image shown as the card thumbnail (e.g. a nice cover
  // for a PDF). Falls back to the file's own image / a generic cover when unset.
  thumbStorageKey String?
  thumbMime       String?
  active         Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([section, active])
}

// A finance company a deal can be approved through (admin-managed list).
// Small key/value store for admin-editable app settings (e.g. the email
// From/Reply-To group addresses). SMTP credentials stay in env, not here.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Admin-managed quick-note templates a reviewer can insert into a note with one
// click (e.g. "Missing void cheque", "Photo doesn't show the serial number").
// Keeps dealer-facing messages consistent and fast to send.
model NoteTemplate {
  id        String   @id @default(cuid())
  label     String // short chip label shown to the reviewer
  body      String   @db.Text // the text inserted into the note box
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

model FinanceCompany {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  // When true, deals approved through this company require a serial number for
  // every product the dealer selected before funding can be submitted (e.g. UEI).
  requiresSerialPerProduct Boolean @default(false)
  createdAt DateTime @default(now())

  applications Application[]
}

// Admin-managed catalog of products a dealer can pick (multi-select) on a deal.
// Seeded from the sales-journal dropdown; editable in Admin → Products. The
// selection is stored on Application.productsSold as names, so archiving or
// renaming a product never rewrites history.
model Product {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// A dealership (external partner). Tenancy boundary: dealer users only ever
// see applications belonging to their own dealer.
// Distributors are separated from regular dealers so recipient pickers (Mail,
// marketplace orders) can group them — no separate login, just organization.
enum DealerType {
  DISTRIBUTOR
  DEALER
}

model Dealer {
  id        String     @id @default(cuid())
  name      String
  type      DealerType @default(DEALER)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users            User[]
  applications     Application[]
  homeDepotStores  HomeDepotStore[]
  dealerAlerts     DealerAlert[]
  mailRecipients   MailRecipient[]
  orders           Order[]
}

// Home Depot stores available to a given dealer. The store field on an
// application is chosen from the dealer's assigned stores (a dropdown, not
// free text). Admins manage which stores belong to each dealer.
model HomeDepotStore {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  number    String // Home Depot store number
  name      String? // optional store name/location label
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  applications Application[]

  @@index([dealerId])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean @default(true)

  // Multi-factor auth. Method is 'APP' (authenticator TOTP) or 'EMAIL' (a code
  // emailed at login). Secret is application-encrypted (APP only).
  mfaEnabled       Boolean @default(false)
  mfaMethod        String? // 'APP' | 'EMAIL'
  mfaSecretEnc     String? // encrypted TOTP secret (APP method)
  // Emailed one-time code (EMAIL method) — stored hashed, short-lived.
  mfaEmailCodeHash      String?
  mfaEmailCodeExpiresAt DateTime?

  // Dealer users belong to a dealer; internal staff have dealerId = null.
  dealerId String?
  dealer   Dealer? @relation(fields: [dealerId], references: [id])

  // Profile & notification preferences
  phone             String?
  notificationEmail String? // where notifications go; falls back to `email`
  notifyStatusUpdates Boolean @default(true)
  notifyNewNotes      Boolean @default(true)
  notifyNewDocuments  Boolean @default(true) // for reviewers/admins
  notifyAttentionAlerts Boolean @default(true) // 2-hour "new deal not looked at" alert (reviewers/admins)
  notifyIdleReminders   Boolean @default(true) // escalating "your deal is waiting on you" reminders (dealers)
  tourSeenAt          DateTime? // when the dealer completed/dismissed the welcome tour (null = not seen)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  // Bumped to immediately invalidate all of this user's existing sessions
  // (deactivation, role/dealer change, password change). The signed session
  // token carries the version it was issued at; getSession rejects a token whose
  // version no longer matches.
  tokenVersion Int @default(0)

  // Password lifecycle. passwordChangedAt drives the 90-day expiry policy;
  // null is treated as "never set" and forces a change at next login.
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens  PasswordResetToken[]
  applicationsCreated  Application[]   @relation("ApplicationCreatedBy")
  applicationsApproved Application[]   @relation("ApplicationApprover")
  financeNumbersVerified Application[] @relation("FinanceNumberVerifier")
  documentsUploaded    Document[]      @relation("DocumentUploader")
  documentsVerified    Document[]      @relation("DocumentVerifier")
  decisions           Decision[]
  statusEvents        StatusEvent[]
  auditLogs           AuditLog[]
  payoutsRecorded     Payout[]
  notesAuthored       Note[]
  confirmations       Confirmation[]
  verificationChecks  VerificationCheck[]
  pushSubscriptions   PushSubscription[]
  alertAcks           AlertAck[]
  contentReads        ContentSectionRead[]
  mailsSent           Mail[]              @relation("MailSender")
  mailReceipts        MailReceipt[]
  mailAttachmentViews MailAttachmentView[]
  ordersCreated       Order[]             @relation("OrderCreatedBy")

  @@index([dealerId])
}

// Marketplace: items GWA makes available for dealers to order (clothing, gear,
// signage). No prices and no payment — it's an ordering system. A submitted
// order emails whoever handles fulfillment.
// A grouping for marketplace items (e.g. Apparel, Signage, Sample Kits). Admins
// can add/rename/reorder/hide these at any time.
model MarketplaceCategory {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MarketplaceItem[]

  @@index([active])
}

model MarketplaceItem {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  options        String[] @default([]) // e.g. sizes: S, M, L, XL — optional
  imageStorageKey String? // product photo (normalized + resized on upload)
  imageMime       String?
  imageSizeBytes  Int?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  // Optional grouping. If the category is deleted, items are kept and become
  // uncategorized (the FK is set null) rather than being removed.
  categoryId String?
  category   MarketplaceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([active])
  @@index([categoryId])
}

model Order {
  id          String   @id @default(cuid())
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  createdById String
  createdBy   User     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  note        String?  @db.Text
  status      String   @default("SUBMITTED") // SUBMITTED | FULFILLED | CANCELLED
  createdAt   DateTime @default(now())

  items OrderItem[]

  @@index([createdAt])
}

model OrderItem {
  id       String           @id @default(cuid())
  orderId  String
  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId   String?
  item     MarketplaceItem? @relation(fields: [itemId], references: [id])
  itemName String // snapshot of the item name at order time
  option   String? // chosen option (e.g. size), if any
  quantity Int
}

// Per-user read state for a dealer content section (Resources / HD Promotions /
// HD Credit Card). Drives the "new content" dot on the nav tab: a section is
// "new" for a user when it has content added/updated after their last view here.
model ContentSectionRead {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  section  ContentSection
  viewedAt DateTime       @default(now()) @updatedAt

  @@unique([userId, section])
}

// Mail sent from GWA (admins/reviewers) to dealers, with file attachments and
// per-user read receipts — so it's documented who viewed what, and when.
model Mail {
  id         String   @id @default(cuid())
  subject    String
  body       String   @db.Text
  requireAck Boolean  @default(false) // ask each reader to confirm they've read it
  allDealers Boolean  @default(false) // sent to every dealer (vs. selected)
  senderId   String
  sender     User     @relation("MailSender", fields: [senderId], references: [id])
  createdAt  DateTime @default(now())

  recipients  MailRecipient[]
  attachments MailAttachment[]
  receipts    MailReceipt[]

  @@index([createdAt])
}

// A dealer this mail was addressed to (ignored when allDealers is true).
model MailRecipient {
  id       String @id @default(cuid())
  mailId   String
  mail     Mail   @relation(fields: [mailId], references: [id], onDelete: Cascade)
  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([mailId, dealerId])
}

// A file attached to a piece of mail (encrypted at rest, like documents).
model MailAttachment {
  id         String   @id @default(cuid())
  mailId     String
  mail       Mail     @relation(fields: [mailId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  checksum   String
  createdAt  DateTime @default(now())

  views MailAttachmentView[]

  @@index([mailId])
}

// Per-user receipt for a piece of mail: when they first opened it, and (when
// the mail requires it) when they acknowledged reading it.
model MailReceipt {
  id             String    @id @default(cuid())
  mailId         String
  mail           Mail      @relation(fields: [mailId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  openedAt       DateTime  @default(now())
  acknowledgedAt DateTime?

  @@unique([mailId, userId])
}

// Per-user record of opening a specific attachment (first + last view + count).
model MailAttachmentView {
  id           String         @id @default(cuid())
  attachmentId String
  attachment   MailAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstViewedAt DateTime      @default(now())
  lastViewedAt  DateTime      @default(now())
  viewCount     Int           @default(1)

  @@unique([attachmentId, userId])
}

// ---------------------------------------------------------------------------
// Applications
// ---------------------------------------------------------------------------

enum Province {
  AB
  BC
  MB
  NB
  NL
  NS
  NT
  NU
  ON
  PE
  QC
  SK
  YT
}

// How the dealer provided the credit application.
enum EntryMethod {
  TYPED // entered directly into the site (full loan application)
  PHOTO // uploaded a photo of the paper credit application
  FINANCEIT // Express: payment already arranged / approved (see paymentMethod)
}

// How the customer paid on an Express (payment-arranged) deal. FINANCEIT means
// financed and requires an approval number; the rest are already-paid deals for
// which GWA produces the HD paperwork.
enum PaymentMethod {
  FINANCEIT
  CASH
  CHEQUE
  CREDIT_CARD
  HD_CREDIT_CARD
}

enum HousingStatus {
  OWN
  RENT
  OTHER
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  RETIRED
  OTHER
}

// Financing program and its product sub-category.
enum ProgramType {
  HD
  GWA
}

enum ProgramCategory {
  WATER
  AIR
  SMELL_BUSTERS
  HVAC
}

enum ConfirmationStatus {
  PENDING // not confirmed yet
  COMPLETED // confirmation call completed, all questions confirmed
  ISSUE // a problem was found during confirmation
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CONDITIONAL // approved pending additional documents
  APPROVED
  DECLINED
  FUNDING_SUBMITTED // dealer has uploaded the funding package
  FUNDING_REVIEW
  FUNDED
  PROBLEM // something needs attention / is blocked
  WITHDRAWN
}

model Application {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(SUBMITTED)

  dealerId String
  dealer   Dealer @relation(fields: [dealerId], references: [id])

  createdById String
  createdBy   User   @relation("ApplicationCreatedBy", fields: [createdById], references: [id])

  // ---- Non-sensitive descriptive fields (plaintext, needed for search/queue)
  province        Province
  programType     ProgramType
  programCategory ProgramCategory
  requestedAmount Decimal @db.Decimal(12, 2)

  // Approval details (set by the reviewer when approving)
  approvedAmount   Decimal?        @db.Decimal(12, 2)
  financeCompanyId String?
  financeCompany   FinanceCompany? @relation(fields: [financeCompanyId], references: [id])
  approvedById     String?
  approvedBy       User?           @relation("ApplicationApprover", fields: [approvedById], references: [id])

  // How this application was provided by the dealer.
  entryMethod EntryMethod @default(TYPED)

  // For Express (payment-arranged) deals: how the customer paid.
  paymentMethod PaymentMethod?

  // Confirmation-call status (surfaced to the dealer with a colour badge).
  confirmationStatus ConfirmationStatus @default(PENDING)

  // Deal details (dealer-entered)
  dateOfSale       DateTime?
  installationDate DateTime?
  homeDepotStoreId String?
  homeDepotStore   HomeDepotStore? @relation(fields: [homeDepotStoreId], references: [id])
  financingNote    String?         @db.Text

  // Reference numbers (used by search; optional until known)
  loanReference    String?
  financeReference String?
  hdReference      String?
  financeItNumber  String? // FinanceIT approval number (approved when present)

  // A reviewer confirms the financing (FinanceIT) number is valid to solidify an
  // approval — important for dealer-auto-approved (FinanceIT) deals, where the
  // "approved" state is dealer-asserted until a reviewer verifies the number.
  financeNumberVerifiedAt   DateTime?
  financeNumberVerifiedById String?
  financeNumberVerifiedBy   User?     @relation("FinanceNumberVerifier", fields: [financeNumberVerifiedById], references: [id])

  // Applicant identity — names/contact kept plaintext for staff triage.
  applicantFirstName String
  applicantLastName  String
  applicantEmail     String
  applicantPhone     String

  // ---- Sensitive PII (application-encrypted ciphertext) ----
  applicantSinEnc         String? // Social Insurance Number
  applicantDobEnc         String? // date of birth
  applicantAddressEnc     String? // full street address
  bankAccountEnc          String? // from void cheque / PAP (transit/institution/account)
  govIdNumberEnc          String? // driver's licence / passport number

  // Co-applicant (optional) — sensitive fields also encrypted.
  coApplicantName    String?
  coApplicantSinEnc  String?

  // incomeAnnual is being migrated to the encrypted column below. New writes go
  // to incomeAnnualEnc; the plaintext column is nulled on write/backfill and
  // dropped in a later migration.
  incomeAnnual    Decimal? @db.Decimal(12, 2)
  incomeAnnualEnc String?
  employer     String?
  notes        String?  @db.Text

  homeownershipRequired Boolean @default(false)

  // Reviewer queue signals. lastDealerActionAt is set whenever the dealer does
  // something the reviewer may need to act on (submit, upload, note, funding);
  // lastReviewerActionAt is set whenever a reviewer/admin acts. When the dealer
  // acted more recently than the reviewer, the deal "needs attention". The kind
  // labels the most recent dealer action for the activity chip.
  lastDealerActionAt   DateTime?
  lastDealerActionKind String? // 'SUBMITTED' | 'DOCUMENT' | 'NOTE' | 'FUNDING'
  lastReviewerActionAt DateTime?
  // Set when a "waited over 2 hours, not looked at" alert was last emailed for
  // this deal, so the alert re-sends at most once per ~2h window (during
  // business hours) instead of every cron run.
  attentionAlertSentAt DateTime?

  // Google Sheets sales-journal sync ("Write to Journal"). We remember which
  // month tab and row this deal was written to, so pressing the button again
  // UPDATES the same row instead of appending a duplicate. Null until synced.
  journalTab      String?
  journalRow      Int?
  journalSyncedAt DateTime?

  // Sales-journal detail fields. Captured by the dealer at intake (and editable
  // by reviewers) so they auto-fill the journal. Free text because installer /
  // salesperson names are office-specific, not a shared list. productsSold is a
  // multi-select from the admin-managed Product catalog. soapIncluded is Yes/No.
  // datePaid is set by a reviewer once the deal is paid.
  leadGenerator   String?
  salespersonName String?
  installerName   String?
  soapIncluded    Boolean?
  productsSold    String[]
  datePaid        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents       Document[]
  serialNumbers   SerialNumber[]
  decisions       Decision[]
  statusEvents    StatusEvent[]
  consents        Consent[]
  loanApplication LoanApplication?
  payouts         Payout[]
  dealNotes       Note[]
  confirmation    Confirmation?
  verificationChecks VerificationCheck[]
  dealerReminders DealerReminder[]

  @@index([dealerId])
  @@index([status])
  @@index([createdAt])
  @@index([homeDepotStoreId])
  @@index([loanReference])
  @@index([financeReference])
  @@index([hdReference])
  @@index([financeItNumber])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

enum DocumentType {
  // Application stage
  SUPPORTING // generic supporting document at application time
  // Funding stage
  SIGNED_CONTRACT
  VOID_CHEQUE_OR_PAP
  INSTALL_PHOTO
  SIGNED_HD_DOCUMENT
  HD_WAIVER
  PROOF_OF_HOMEOWNERSHIP
  GOVERNMENT_ID
  // Reviewer -> dealer paperwork
  HD_PAPERWORK
  FINANCING_PAPERWORK
  RELEASE_OF_FUNDS
  OTHER
}

enum DocumentStage {
  APPLICATION
  FUNDING
  REVIEWER // paperwork uploaded by GWA staff for the dealer
}

model Document {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type  DocumentType
  stage DocumentStage

  fileName     String // standardized display name (customer + date + timestamp)
  originalName String? // the file name as uploaded
  mimeType     String
  sizeBytes    Int
  // Storage key (S3 key or local relative path). File bytes are encrypted at
  // rest (SSE-KMS on S3, or envelope-encrypted on the local driver).
  storageKey String
  checksum   String // sha-256 of plaintext, for integrity

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  // Reviewer verification — a reviewer views the document and marks it complete.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([type])
}

// Extended loan-application details captured when the dealer types the
// application in (entryMethod = TYPED), mirroring the paper loan application.
// The most sensitive identifiers (SIN, DOB, street address, banking, gov ID
// number) live encrypted on Application; these lower-sensitivity structured
// fields are stored here (still protected by database-at-rest encryption).
model LoanApplication {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Personal details
  middleName    String?
  homePhone     String?
  maritalStatus String?

  // Housing
  housingStatus     HousingStatus?
  monthlyHousingCost    Decimal? @db.Decimal(10, 2) // migrating → monthlyHousingCostEnc
  monthlyHousingCostEnc String?
  yearsAtAddress    Int?
  city              String?
  addressProvince   String?
  postalCode        String?

  // Optional additional addresses. The street lines are encrypted (migrating);
  // city/province/postal stay plaintext (lower sensitivity, kept for search).
  mailingAddress    String? // migrating → mailingAddressEnc
  mailingAddressEnc String?
  mailingCity      String?
  mailingProvince  String?
  mailingPostal    String?
  previousAddress    String? // migrating → previousAddressEnc
  previousAddressEnc String?
  previousCity     String?
  previousProvince String?
  previousPostal   String?
  worksiteAddress    String? // migrating → worksiteAddressEnc
  worksiteAddressEnc String?
  worksiteCity     String?
  worksiteProvince String?
  worksitePostal   String?

  // Borrower identification
  idType     String?
  idProvince String?
  idExpiry   DateTime?

  // Employment & income
  businessName      String?
  positionTitle     String?
  employerAddress    String? // migrating → employerAddressEnc
  employerAddressEnc String?
  employerPhone     String?
  grossMonthlyIncome    Decimal? @db.Decimal(12, 2) // migrating → grossMonthlyIncomeEnc
  grossMonthlyIncomeEnc String?
  timeAtJobYears    Int?
  employmentStatus  EmploymentStatus?

  // ---- Co-applicant (optional) ----
  // Revealed on the form when a co-applicant name is entered; collects the same
  // details as the main applicant. Sensitive fields (date of birth, street
  // address, government ID number) are application-encrypted at rest.
  coFirstName     String?
  coLastName      String?
  coMiddleName    String?
  coDobEnc        String?
  coEmail         String?
  coPhone         String?
  coHomePhone     String?
  coMaritalStatus String?
  coRelationship  String?

  coAddressEnc    String?
  coCity          String?
  coProvince      String?
  coPostal        String?

  coIdType         String?
  coGovIdNumberEnc String?
  coIdProvince     String?
  coIdExpiry       DateTime?

  coBusinessName       String?
  coPositionTitle      String?
  coEmployerAddress    String? // migrating → coEmployerAddressEnc
  coEmployerAddressEnc String?
  coEmployerPhone      String?
  coGrossMonthlyIncome    Decimal? @db.Decimal(12, 2) // migrating → coGrossMonthlyIncomeEnc
  coGrossMonthlyIncomeEnc String?
  coTimeAtJobYears     Int?
  coEmploymentStatus   EmploymentStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A payment made to the dealer on a deal — the dealer's payout receipt.
// A deal can have more than one (e.g. partial payments); together they read
// as a statement of what was paid.
model Payout {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(12, 2)
  paidOn        DateTime
  method        String? // e.g. EFT, cheque
  reference     String? // payment reference number
  note          String?
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// A note on a deal. internal=false is visible to the dealer (a conversation
// between GWA and the dealer); internal=true is reviewer/admin only.
model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  body          String      @db.Text
  internal      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// A confirmation call worked through the UEI confirmation script. One per deal.
model Confirmation {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Header
  productName   String?
  numberOfCalls Int?
  city          String?
  district      String?
  phoneNumber   String?

  // Questions 1–3
  installedWorking        Boolean @default(false)
  performingAsRepresented Boolean @default(false)
  receivedEverything      Boolean @default(false)

  // Terms
  financingAmount        Decimal?  @db.Decimal(12, 2)
  termMonths             Int?
  firstInstallmentAmount Decimal?  @db.Decimal(12, 2)
  firstInstallmentDate   DateTime?

  // Verification 4–6
  termsAgreed        Boolean @default(false)
  signatureConfirmed Boolean @default(false)
  notTrialOffer      Boolean @default(false)

  specialArrangements String?
  hdNotes             String? @db.Text // HD confirmation notes
  issueNote           String? @db.Text

  confirmedById String?
  confirmedBy   User?     @relation(fields: [confirmedById], references: [id])
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SerialNumber {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  value         String
  productLabel  String? // e.g. "Furnace", "Water Heater"
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// A reviewer's funding verification checklist item (Rule 2). Before a deal can
// be funded, a reviewer works through a fixed list of checks (photo shows every
// product, signatures present, PAP/void cheque on file, serials match). Each
// item is CONFIRMED or flagged as a PROBLEM. A PROBLEM requires a note, which is
// posted as a dealer-visible note and notifies the dealer. Funding is hard-gated
// until every applicable item is CONFIRMED.
enum VerificationStatus {
  PENDING
  CONFIRMED
  PROBLEM
}

model VerificationCheck {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  key           String // stable item key (see VERIFICATION_CHECKS in constants)
  status        VerificationStatus @default(PENDING)
  note          String?            @db.Text // required when status = PROBLEM
  checkedById   String?
  checkedBy     User?              @relation(fields: [checkedById], references: [id])
  checkedAt     DateTime?
  updatedAt     DateTime           @updatedAt

  @@unique([applicationId, key])
  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Decisions, status history, consent, audit
// ---------------------------------------------------------------------------

enum DecisionType {
  APPROVE
  DECLINE
  CONDITIONAL
  REQUEST_DOCS
  FUND
}

model Decision {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DecisionType
  notes         String?      @db.Text
  decidedById   String
  decidedBy     User         @relation(fields: [decidedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([applicationId])
}

model StatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from          ApplicationStatus?
  to            ApplicationStatus
  actorId       String
  actor         User              @relation(fields: [actorId], references: [id])
  note          String?
  createdAt     DateTime          @default(now())

  @@index([applicationId])
}

// Records consent captured from the dealer/applicant at submission time.
model Consent {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  policyVersion  String
  consentText    String      @db.Text
  ipAddress      String?
  capturedAt     DateTime    @default(now())

  @@index([applicationId])
}

// Append-only audit trail of sensitive access and mutations (PIPEDA / Law 25).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  // Immutable snapshot of who acted, captured at write time, so attribution
  // survives even if the user is later deleted (actorId is then nulled).
  actorName  String?
  actorEmail String?
  action     String   // e.g. "PII_DECRYPT", "APPLICATION_SUBMIT", "DOC_DOWNLOAD"
  entityType String   // e.g. "Application", "Document", "User"
  entityId   String?
  detail     String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
